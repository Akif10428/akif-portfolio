# Environment variables for Akif Hossen portfolio

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID (numeric) — defaults to site.metaPixelId if empty
VITE_META_PIXEL_ID=3393551357410244

# Google reCAPTCHA v2 site key (checkbox) — public key only
VITE_RECAPTCHA_SITE_KEY=6Ldo5WotAAAAANh1J9enRhPCplKSiHb3QSRbtNHo

# Formspree form endpoint (e.g. https://formspree.io/f/xxxxxx)
# Put the reCAPTCHA SECRET key in Formspree settings — never in the frontend
VITE_FORMSPREE_ENDPOINT=

# WhatsApp number with country code (defaults to site content if empty)
VITE_WHATSAPP_NUMBER=8801622670612

# Public contact email (defaults to site content if empty)
VITE_CONTACT_EMAIL=akifratul@gmail.com

# Messenger link for personal profile chat (e.g. https://m.me/your.username)
VITE_MESSENGER_HREF=https://m.me/akifratul
